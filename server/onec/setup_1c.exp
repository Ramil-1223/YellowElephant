#!/usr/bin/expect -f

set timeout -1

spawn ./setup-full-8.3.25.1286-x86_64.run

# Выбор языка (16 - Русский)
expect "Пожалуйста, выберите опцию \\\[16\\\] :"
send "16\r"

# Основные компоненты
expect "1С:Предприятие \\\[Y/n\\\] :"
send "n\r"

expect "1С:Предприятие - Тонкий клиент \\\[y/N\\\] :"
send "n\r"

expect "1С:Предприятие - Тонкий клиент, файловый вариант \\\[y/N\\\] :"
send "n\r"

expect "Зависимости \\\[y/N\\\] :"
send "n\r"

expect "Установить ярлыки \\\[y/N\\\] :"
send "n\r"

expect "Сервер 1С:Предприятия 8 \\\[y/N\\\] :"
send "n\r"

expect "Модули расширения веб-сервера \\\[y/N\\\] :"
send "n\r"

expect "Администрирование сервера 1С:Предприятия \\\[y/N\\\] :"
send "y\r"

expect "Интерфейсы на различных языках : Y \\(Cannot be edited\\)"

# Выбор языков интерфейса
