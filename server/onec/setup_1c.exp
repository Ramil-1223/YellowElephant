send "n\r"

expect "Интерфейсы на различных языках - Испанский \\\[y/N\\\] :"
send "n\r"

expect "Интерфейсы на различных языках - Латышский \\\[y/N\\\] :"
send "n\r"

expect "Интерфейсы на различных языках - Литовский \\\[y/N\\\] :"
send "n\r"

expect "Интерфейсы на различных языках - Немецкий \\\[y/N\\\] :"
